{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/the-business-translator/baseline-record.schema.json",
  "title": "Regulatory Intelligence Baseline Record",
  "description": "Defines separate input and expected-label records for the 24-case synthetic baseline.",
  "oneOf": [
    {
      "$ref": "#/$defs/case_input"
    },
    {
      "$ref": "#/$defs/case_label"
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_use": {
      "enum": [
        "binding_candidate",
        "guidance_only",
        "final_change_event",
        "draft_watchlist",
        "historical_only",
        "strategy_context",
        "blocked"
      ]
    },
    "obligation_outcome": {
      "enum": [
        "candidate_binding_obligation",
        "guidance_context",
        "final_change_pending_commencement",
        "draft_or_watchlist",
        "strategy_context",
        "superseded",
        "applicability_uncertain",
        "out_of_scope",
        "source_conflict",
        "unsupported_obligation",
        "blocked_source"
      ]
    },
    "applicability_status": {
      "enum": [
        "applicable_candidate",
        "not_applicable_candidate",
        "applicability_uncertain",
        "out_of_scope",
        "not_assessed"
      ]
    },
    "mapping_status": {
      "enum": [
        "mapped",
        "partially_mapped",
        "no_suitable_control_identified"
      ]
    },
    "assurance_outcome": {
      "enum": [
        "mapped_and_evidenced",
        "insufficient_evidence",
        "potential_control_gap"
      ]
    },
    "gap_type": {
      "enum": [
        "no_control",
        "partial_coverage",
        "control_design",
        "operating_evidence_missing",
        "operating_exception",
        "ownership",
        "evidence_integrity",
        "independent_testing"
      ]
    },
    "action_type": {
      "enum": [
        "evidence_request",
        "mapping_review",
        "control_design_change",
        "operating_remediation",
        "ownership_confirmation",
        "independent_testing"
      ]
    },
    "evidence_type": {
      "enum": [
        "policy_or_framework",
        "procedure",
        "system_configuration",
        "completed_control_record",
        "case_or_transaction_sample",
        "exception_or_escalation_record",
        "management_information",
        "governance_minutes",
        "training_record",
        "independent_test_result",
        "remediation_evidence",
        "third_party_assurance"
      ]
    },
    "case_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "dataset_version",
        "case_id",
        "workstream",
        "case_stage",
        "title",
        "objective",
        "source_ids",
        "source_excerpt_or_fact",
        "institution_facts",
        "missing_facts",
        "candidate_statement",
        "upstream_obligation",
        "proposed_mapping",
        "presented_evidence",
        "proposal_under_test",
        "review_question"
      ],
      "properties": {
        "record_kind": {
          "const": "case_input"
        },
        "dataset_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "pattern": "^(AML|CON)-[0-9]{3}$"
        },
        "workstream": {
          "enum": [
            "aml_cft",
            "market_conduct"
          ]
        },
        "case_stage": {
          "enum": [
            "source_classification",
            "obligation_assessment",
            "control_assurance",
            "end_to_end"
          ]
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "objective": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SA-[A-Z0-9-]+$"
          }
        },
        "source_excerpt_or_fact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "institution_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "missing_facts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "candidate_statement": {
          "$ref": "#/$defs/nullable_string"
        },
        "upstream_obligation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supplied",
            "status",
            "obligation_id",
            "fixture_path"
          ],
          "properties": {
            "supplied": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "approved",
                "pending",
                "not_applicable"
              ]
            },
            "obligation_id": {
              "$ref": "#/$defs/nullable_string"
            },
            "fixture_path": {
              "$ref": "#/$defs/nullable_string"
            }
          }
        },
        "proposed_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control_ids",
            "owner_role",
            "mapping_status"
          ],
          "properties": {
            "control_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^C-[A-Z]+-[0-9]{3}$"
              }
            },
            "owner_role": {
              "$ref": "#/$defs/nullable_string"
            },
            "mapping_status": {
              "oneOf": [
                {
                  "$ref": "#/$defs/mapping_status"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "presented_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "evidence_type",
              "status",
              "description"
            ],
            "properties": {
              "evidence_id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "evidence_type": {
                "$ref": "#/$defs/evidence_type"
              },
              "status": {
                "enum": [
                  "supplied",
                  "missing",
                  "unavailable"
                ]
              },
              "description": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        "proposal_under_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_use_disposition",
            "obligation_outcome",
            "applicability_status",
            "assurance_outcome",
            "gap_claim",
            "escalation_required"
          ],
          "properties": {
            "source_use_disposition": {
              "$ref": "#/$defs/source_use"
            },
            "obligation_outcome": {
              "$ref": "#/$defs/obligation_outcome"
            },
            "applicability_status": {
              "$ref": "#/$defs/applicability_status"
            },
            "assurance_outcome": {
              "oneOf": [
                {
                  "$ref": "#/$defs/assurance_outcome"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gap_claim": {
              "oneOf": [
                {
                  "$ref": "#/$defs/gap_type"
                },
                {
                  "type": "null"
                }
              ]
            },
            "escalation_required": {
              "type": "boolean"
            }
          }
        },
        "review_question": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "case_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "dataset_version",
        "case_id",
        "workstream",
        "expected",
        "error_tags"
      ],
      "properties": {
        "record_kind": {
          "const": "case_label"
        },
        "dataset_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "pattern": "^(AML|CON)-[0-9]{3}$"
        },
        "workstream": {
          "enum": [
            "aml_cft",
            "market_conduct"
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_use_disposition",
            "obligation_outcome",
            "applicability_status",
            "assurance_gate",
            "mapping_status",
            "control_mappings",
            "assurance_outcome",
            "gap_types",
            "gap_severity",
            "remediation_action_types",
            "escalation_required",
            "escalation_roles",
            "human_review_required",
            "compliance_conclusion",
            "rationale"
          ],
          "properties": {
            "source_use_disposition": {
              "$ref": "#/$defs/source_use"
            },
            "obligation_outcome": {
              "$ref": "#/$defs/obligation_outcome"
            },
            "applicability_status": {
              "$ref": "#/$defs/applicability_status"
            },
            "assurance_gate": {
              "enum": [
                "not_entered",
                "entered"
              ]
            },
            "mapping_status": {
              "oneOf": [
                {
                  "$ref": "#/$defs/mapping_status"
                },
                {
                  "const": "not_applicable"
                }
              ]
            },
            "control_mappings": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "control_id",
                  "owner_role"
                ],
                "properties": {
                  "control_id": {
                    "type": "string",
                    "pattern": "^C-[A-Z]+-[0-9]{3}$"
                  },
                  "owner_role": {
                    "$ref": "#/$defs/non_empty_string"
                  }
                }
              }
            },
            "assurance_outcome": {
              "oneOf": [
                {
                  "$ref": "#/$defs/assurance_outcome"
                },
                {
                  "const": "not_applicable"
                }
              ]
            },
            "gap_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/gap_type"
              }
            },
            "gap_severity": {
              "enum": [
                "not_applicable",
                "unassessed",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "remediation_action_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/action_type"
              }
            },
            "escalation_required": {
              "type": "boolean"
            },
            "escalation_roles": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              }
            },
            "human_review_required": {
              "const": true
            },
            "compliance_conclusion": {
              "const": "not_determined"
            },
            "rationale": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        },
        "error_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "approved_source_gate",
              "binding_source",
              "guidance_boundary",
              "draft_boundary",
              "superseded_source",
              "commencement_uncertainty",
              "blocked_source",
              "unofficial_compilation",
              "missing_applicability_fact",
              "out_of_scope_profile",
              "unsupported_extension",
              "premature_control_assurance",
              "human_approval_boundary",
              "source_conflict",
              "correct_mapping",
              "owner_routing",
              "operating_evidence_missing",
              "genuine_control_gap",
              "false_positive_gap",
              "partial_mapping",
              "missed_escalation",
              "unnecessary_escalation"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected": {
                "properties": {
                  "assurance_gate": {
                    "const": "not_entered"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "properties": {
                  "mapping_status": {
                    "const": "not_applicable"
                  },
                  "control_mappings": {
                    "maxItems": 0
                  },
                  "assurance_outcome": {
                    "const": "not_applicable"
                  },
                  "gap_types": {
                    "maxItems": 0
                  },
                  "gap_severity": {
                    "const": "not_applicable"
                  },
                  "remediation_action_types": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected": {
                "properties": {
                  "assurance_gate": {
                    "const": "entered"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "properties": {
                  "mapping_status": {
                    "$ref": "#/$defs/mapping_status"
                  },
                  "control_mappings": {
                    "minItems": 1
                  },
                  "assurance_outcome": {
                    "$ref": "#/$defs/assurance_outcome"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
