{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/compliance-evaluator/label-authority-overlay-v1.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "dataset_version",
    "record_kind",
    "base_dataset_version",
    "status",
    "adjudication_id",
    "applies_to_future_workflow_versions",
    "retrospective_scoring_permitted",
    "overlays"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "record_kind": {"const": "label_authority_overlay"},
    "base_dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "approved_synthetic", "retired"]},
    "adjudication_id": {"type": "string", "minLength": 1},
    "applies_to_future_workflow_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
    },
    "retrospective_scoring_permitted": {"const": false},
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "coverage_state",
          "covered_element_ids",
          "uncovered_element_ids",
          "evidence_condition",
          "remediation_action_types",
          "escalation_required",
          "escalation_roles"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "coverage_state": {"enum": ["complete", "partial", "absent", "not_assessable"]},
          "covered_element_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "uncovered_element_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_condition": {"enum": ["sufficient", "design_deficiency", "missing_operating_evidence", "adverse_operating_evidence", "not_assessable"]},
          "gap_severity": {"enum": ["not_applicable", "unassessed", "low", "medium", "high"]},
          "remediation_action_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "escalation_required": {"type": "boolean"},
          "escalation_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
