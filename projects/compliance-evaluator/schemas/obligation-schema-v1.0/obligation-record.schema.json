{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebusinesstranslator.com/schemas/obligation-record-v1.0.schema.json",
  "title": "Candidate Regulatory Obligation Record v1.0",
  "description": "A traceable, status-controlled and human-reviewable candidate obligation record for the South African synthetic evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "obligation_id",
    "record_type",
    "lifecycle_status",
    "source",
    "source_gate",
    "classification",
    "obligation",
    "applicability",
    "change",
    "operating_impact",
    "routing",
    "assessment",
    "generation",
    "human_review",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^OBL-(AML|CONDUCT)-[0-9]{4}$"
    },
    "record_type": {
      "const": "candidate_obligation"
    },
    "lifecycle_status": {
      "enum": [
        "generated_candidate",
        "human_reviewed",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "source_gate": {
      "$ref": "#/$defs/source_gate"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "obligation": {
      "$ref": "#/$defs/obligation"
    },
    "applicability": {
      "$ref": "#/$defs/applicability"
    },
    "change": {
      "$ref": "#/$defs/change"
    },
    "operating_impact": {
      "$ref": "#/$defs/operating_impact"
    },
    "routing": {
      "$ref": "#/$defs/routing"
    },
    "assessment": {
      "$ref": "#/$defs/assessment"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "human_review": {
      "$ref": "#/$defs/human_review"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "enum": [
        "Board or delegated governance committee",
        "Head of Compliance",
        "AML Compliance Officer",
        "Legal Counsel",
        "Regulatory Change Lead",
        "Conduct Risk Officer",
        "Business or Control Owner",
        "Independent Assurance"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pack_id",
        "source_pack_version",
        "source_id",
        "source_title",
        "source_status",
        "instrument_type",
        "document_sha256",
        "hash_verified",
        "status_verified_at",
        "locator"
      ],
      "properties": {
        "source_pack_id": {
          "const": "SA-REG-SOURCE-PACK-001"
        },
        "source_pack_version": {
          "const": "1.0"
        },
        "source_id": {
          "enum": [
            "SA-AML-SP-001",
            "SA-AML-SP-002",
            "SA-AML-SP-003",
            "SA-AML-SP-004",
            "SA-AML-SP-005",
            "SA-AML-SP-W01",
            "SA-CONDUCT-SP-001",
            "SA-CONDUCT-SP-002",
            "SA-CONDUCT-SP-003",
            "SA-CONDUCT-SP-004"
          ]
        },
        "source_title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_status": {
          "enum": [
            "in_force_with_amendments",
            "official_unofficial_compilation",
            "current_official_guidance",
            "superseded",
            "final_issued_commencement_unverified",
            "draft_consultation",
            "in_force_as_amended",
            "in_force_with_staged_commencement",
            "strategy_not_binding_instrument"
          ]
        },
        "instrument_type": {
          "enum": [
            "legislation",
            "official_reference_compilation",
            "guidance_note",
            "directive",
            "draft_directive",
            "subordinate_code",
            "amendment_notice",
            "regulatory_strategy"
          ]
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash_verified": {
          "type": "boolean"
        },
        "status_verified_at": {
          "type": "string",
          "format": "date"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator_text",
            "quote"
          ],
          "properties": {
            "locator_text": {
              "$ref": "#/$defs/non_empty_string"
            },
            "page_label": {
              "$ref": "#/$defs/nullable_string"
            },
            "section": {
              "$ref": "#/$defs/nullable_string"
            },
            "clause": {
              "$ref": "#/$defs/nullable_string"
            },
            "paragraph": {
              "$ref": "#/$defs/nullable_string"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "anyOf": [
            {
              "required": [
                "page_label"
              ],
              "properties": {
                "page_label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "section"
              ],
              "properties": {
                "section": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "clause"
              ],
              "properties": {
                "clause": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "paragraph"
              ],
              "properties": {
                "paragraph": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "source_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_candidate_statement_extraction",
        "manifest_binding_obligation_extraction",
        "record_use",
        "gate_passed",
        "gate_reason"
      ],
      "properties": {
        "manifest_candidate_statement_extraction": {
          "enum": [
            "blocked",
            "locator_discovery_only",
            "allowed_as_guidance_only",
            "historical_only",
            "allowed_as_final_change_event_with_commencement_uncertainty",
            "allowed_as_proposed_requirement_only",
            "blocked_until_amendment_chain_applied",
            "allowed_from_amendment_text_with_commencement_locator",
            "allowed_as_strategy_context_only"
          ]
        },
        "manifest_binding_obligation_extraction": {
          "enum": [
            "blocked",
            "blocked_pending_gazette_verification",
            "blocked_as_standalone_source",
            "allowed_with_human_review_and_staged_date_control"
          ]
        },
        "record_use": {
          "enum": [
            "binding_candidate",
            "guidance_only",
            "final_change_event",
            "draft_watchlist",
            "historical_only",
            "strategy_context",
            "blocked"
          ]
        },
        "gate_passed": {
          "type": "boolean"
        },
        "gate_reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normative_strength",
        "legal_effect",
        "source_use_disposition",
        "effective_from",
        "transition_end",
        "classification_rationale"
      ],
      "properties": {
        "normative_strength": {
          "enum": [
            "binding_candidate",
            "official_guidance",
            "proposed",
            "strategy_context",
            "historical_only",
            "unknown"
          ]
        },
        "legal_effect": {
          "enum": [
            "in_force",
            "in_force_staged",
            "not_in_force_draft",
            "commencement_unverified",
            "superseded",
            "not_binding_guidance",
            "not_binding_context",
            "not_determined"
          ]
        },
        "source_use_disposition": {
          "enum": [
            "binding_candidate",
            "guidance_context",
            "final_change_pending_commencement",
            "draft_or_watchlist",
            "superseded_historical",
            "strategy_context",
            "blocked_source"
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "transition_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "classification_rationale": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomic",
        "actor",
        "modality",
        "action",
        "object_or_outcome",
        "trigger_conditions",
        "timing",
        "exceptions_and_dependencies",
        "evidence_or_reporting_requirements",
        "atomic_summary",
        "interpretation_notes",
        "support_status",
        "unsupported_extension_detected"
      ],
      "properties": {
        "atomic": {
          "const": true
        },
        "actor": {
          "$ref": "#/$defs/non_empty_string"
        },
        "modality": {
          "enum": [
            "must",
            "must_not",
            "should",
            "may",
            "other"
          ]
        },
        "action": {
          "$ref": "#/$defs/non_empty_string"
        },
        "object_or_outcome": {
          "$ref": "#/$defs/non_empty_string"
        },
        "trigger_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "source_supported"
          ],
          "properties": {
            "type": {
              "enum": [
                "event_driven",
                "periodic",
                "deadline",
                "continuous",
                "not_specified"
              ]
            },
            "value": {
              "$ref": "#/$defs/nullable_string"
            },
            "source_supported": {
              "type": "boolean"
            }
          }
        },
        "exceptions_and_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "evidence_or_reporting_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "atomic_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "interpretation_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "support_status": {
          "enum": [
            "fully_supported",
            "partially_supported",
            "unsupported"
          ]
        },
        "unsupported_extension_detected": {
          "type": "boolean"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_sha256",
        "status",
        "facts_used",
        "missing_facts",
        "assumptions",
        "rationale",
        "human_confirmation_required"
      ],
      "properties": {
        "profile_id": {
          "const": "SA-IWM-SYN-001"
        },
        "profile_version": {
          "const": "1.0"
        },
        "profile_sha256": {
          "const": "b55c0ed45adebc43efa45f81feab1d80633de0f6c6701de3994b08d76df866f4"
        },
        "status": {
          "enum": [
            "applicable_candidate",
            "not_applicable_candidate",
            "applicability_uncertain",
            "out_of_scope",
            "not_assessed"
          ]
        },
        "facts_used": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_path",
              "fact_value"
            ],
            "properties": {
              "fact_path": {
                "$ref": "#/$defs/non_empty_string"
              },
              "fact_value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        "missing_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        },
        "human_confirmation_required": {
          "const": true
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_type",
        "previous_source_id",
        "previous_obligation_id",
        "change_summary"
      ],
      "properties": {
        "change_type": {
          "enum": [
            "new",
            "amended",
            "clarified",
            "superseded",
            "unchanged",
            "not_assessed"
          ]
        },
        "previous_source_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "previous_obligation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^OBL-(AML|CONDUCT)-[0-9]{4}$"
        },
        "change_summary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "operating_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact_status",
        "affected_process_ids",
        "affected_control_ids",
        "affected_roles",
        "affected_artifacts",
        "rationale"
      ],
      "properties": {
        "impact_status": {
          "enum": [
            "not_assessed",
            "candidate",
            "human_confirmed"
          ]
        },
        "affected_process_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P-(REG|AML|CON|ASSURE)-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "affected_control_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C-(REG|AML|CON|ASSURE)-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "affected_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          },
          "uniqueItems": true
        },
        "affected_artifacts": {
          "type": "array",
          "items": {
            "enum": [
              "governance_framework",
              "policy",
              "RMCP",
              "procedure",
              "system_rule",
              "data_field",
              "customer_communication",
              "training",
              "management_information",
              "regulatory_submission",
              "control_evidence",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_owner_role",
        "required_reviewer_roles",
        "escalation_required",
        "escalation_reason"
      ],
      "properties": {
        "proposed_owner_role": {
          "$ref": "#/$defs/role"
        },
        "required_reviewer_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          },
          "uniqueItems": true
        },
        "escalation_required": {
          "type": "boolean"
        },
        "escalation_reason": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "confidence",
        "limitations",
        "next_action"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "candidate_binding_obligation",
            "guidance_context",
            "final_change_pending_commencement",
            "draft_or_watchlist",
            "strategy_context",
            "superseded",
            "applicability_uncertain",
            "out_of_scope",
            "source_conflict",
            "unsupported_obligation",
            "blocked_source"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "next_action": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_version",
        "model_id",
        "prompt_version",
        "generated_at",
        "run_id"
      ],
      "properties": {
        "workflow_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "model_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "prompt_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "reviewer_role",
        "reviewer_id",
        "decision_rationale",
        "reviewed_at"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "enum": [
            "pending",
            "accepted",
            "amended",
            "rejected"
          ]
        },
        "reviewer_role": {
          "oneOf": [
            {
              "$ref": "#/$defs/role"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "decision_rationale": {
          "$ref": "#/$defs/nullable_string"
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "updated_at",
        "created_by",
        "change_log"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "enum": [
            "ai_assisted",
            "human"
          ]
        },
        "change_log": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timestamp",
              "actor",
              "change"
            ],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "actor": {
                "$ref": "#/$defs/non_empty_string"
              },
              "change": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_status": {
                "const": "draft_consultation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "proposed"
              },
              "legal_effect": {
                "const": "not_in_force_draft"
              },
              "source_use_disposition": {
                "const": "draft_or_watchlist"
              },
              "effective_from": {
                "type": "null"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "draft_watchlist"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "draft_or_watchlist"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_status": {
                "const": "current_official_guidance"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "official_guidance"
              },
              "legal_effect": {
                "const": "not_binding_guidance"
              },
              "source_use_disposition": {
                "const": "guidance_context"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "guidance_only"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "guidance_context"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_status": {
                "const": "strategy_not_binding_instrument"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "strategy_context"
              },
              "legal_effect": {
                "const": "not_binding_context"
              },
              "source_use_disposition": {
                "const": "strategy_context"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "strategy_context"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "strategy_context"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_status": {
                "const": "final_issued_commencement_unverified"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "legal_effect": {
                "const": "commencement_unverified"
              },
              "source_use_disposition": {
                "const": "final_change_pending_commencement"
              },
              "effective_from": {
                "type": "null"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "final_change_event"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "final_change_pending_commencement"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "proposed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "legal_effect": {
                "const": "not_in_force_draft"
              },
              "source_use_disposition": {
                "const": "draft_or_watchlist"
              },
              "effective_from": {
                "type": "null"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "draft_watchlist"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "draft_or_watchlist"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "official_guidance"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "legal_effect": {
                "const": "not_binding_guidance"
              },
              "source_use_disposition": {
                "const": "guidance_context"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "guidance_only"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "guidance_context"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "strategy_context"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "legal_effect": {
                "const": "not_binding_context"
              },
              "source_use_disposition": {
                "const": "strategy_context"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "strategy_context"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "strategy_context"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_status": {
                "const": "superseded"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "historical_only"
              },
              "legal_effect": {
                "const": "superseded"
              },
              "source_use_disposition": {
                "const": "superseded_historical"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "historical_only"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "superseded"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "legal_effect": {
                "const": "commencement_unverified"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "source_use_disposition": {
                "const": "final_change_pending_commencement"
              },
              "effective_from": {
                "type": "null"
              }
            }
          },
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "final_change_event"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "final_change_pending_commencement"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "status": {
                "const": "applicability_uncertain"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "applicability": {
            "properties": {
              "missing_facts": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "status": {
                "const": "applicable_candidate"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "applicability": {
            "properties": {
              "missing_facts": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "candidate_binding_obligation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_gate": {
            "properties": {
              "manifest_binding_obligation_extraction": {
                "const": "allowed_with_human_review_and_staged_date_control"
              },
              "record_use": {
                "const": "binding_candidate"
              },
              "gate_passed": {
                "const": true
              }
            }
          },
          "classification": {
            "properties": {
              "normative_strength": {
                "const": "binding_candidate"
              },
              "legal_effect": {
                "enum": [
                  "in_force",
                  "in_force_staged"
                ]
              },
              "source_use_disposition": {
                "const": "binding_candidate"
              }
            }
          },
          "obligation": {
            "properties": {
              "support_status": {
                "const": "fully_supported"
              },
              "unsupported_extension_detected": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_gate": {
            "properties": {
              "gate_passed": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_gate": {
            "properties": {
              "record_use": {
                "const": "blocked"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "blocked_source"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "obligation": {
                "properties": {
                  "support_status": {
                    "const": "unsupported"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "obligation": {
                "properties": {
                  "unsupported_extension_detected": {
                    "const": true
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "unsupported_obligation"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "generated_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "status": {
                "const": "pending"
              },
              "reviewer_role": {
                "type": "null"
              },
              "reviewer_id": {
                "type": "null"
              },
              "decision_rationale": {
                "type": "null"
              },
              "reviewed_at": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "amended"
                ]
              },
              "reviewer_role": {
                "$ref": "#/$defs/role"
              },
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_rationale": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ]
}
