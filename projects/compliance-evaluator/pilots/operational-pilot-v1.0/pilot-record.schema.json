{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sa-reg-operational-pilot-record-v1.0.schema.json",
  "title": "Operational Pilot Work-Item Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["pilot_id","work_item_id","workstream","decision_stage","source_references","baseline","ai_advisory","accepted_decision","review","incidents"],
  "properties": {
    "pilot_id": {"const":"SA-REG-OP-PILOT-001"},
    "work_item_id": {"type":"string","minLength":1},
    "workstream": {"enum":["aml_cft","market_conduct"]},
    "decision_stage": {"enum":["source_and_applicability","obligation_to_control_assurance"]},
    "source_references": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["source_id","version","locator","approved"],"properties":{"source_id":{"type":"string"},"version":{"type":"string"},"locator":{"type":"string"},"approved":{"const":true}}}},
    "baseline": {"$ref":"#/$defs/effortRecord"},
    "ai_advisory": {"type":"object","additionalProperties":false,"required":["workflow_version","manifest_sha256","decision","preparation_minutes","touch_count"],"properties":{"workflow_version":{"const":"1.7"},"manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"decision":{"type":"object"},"preparation_minutes":{"type":"number","minimum":0},"touch_count":{"type":"integer","minimum":0}}},
    "accepted_decision": {"type":"object","additionalProperties":false,"required":["decision","initial_routing_accepted","escalation_required","escalation_roles","corrections_to_ai","rationale"],"properties":{"decision":{"type":"object"},"initial_routing_accepted":{"type":"boolean"},"escalation_required":{"type":"boolean"},"escalation_roles":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"corrections_to_ai":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"rationale":{"type":"string","minLength":1}}},
    "review": {"type":"object","additionalProperties":false,"required":["analyst_id","reviewer_id","reviewer_role","reviewed_at","human_approved"],"properties":{"analyst_id":{"type":"string","minLength":1},"reviewer_id":{"type":"string","minLength":1},"reviewer_role":{"type":"string","minLength":1},"reviewed_at":{"type":"string","format":"date-time"},"human_approved":{"const":true}}},
    "incidents": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["severity","description","resolved"],"properties":{"severity":{"enum":["low","medium","high","critical"]},"description":{"type":"string","minLength":1},"resolved":{"type":"boolean"}}}}
  },
  "$defs": {"effortRecord":{"type":"object","additionalProperties":false,"required":["decision","preparation_minutes","touch_count","elapsed_working_minutes"],"properties":{"decision":{"type":"object"},"preparation_minutes":{"type":"number","minimum":0},"touch_count":{"type":"integer","minimum":0},"elapsed_working_minutes":{"type":"number","minimum":0}}}}
}
