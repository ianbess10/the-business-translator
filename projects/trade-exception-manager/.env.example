# Model provider: mock | openai
MODEL_PROVIDER=mock

# Required when MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Optional OpenAI settings
OPENAI_MODEL=gpt-4o-mini
# Leave unset/commented unless using an OpenAI-compatible proxy.
# An empty OPENAI_BASE_URL= breaks the SDK (invalid base URL).
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0

# Optional run metadata
RUN_LABEL=

# Optional test-set override (defaults to frozen trade-exception-test-set-v1.0)
# TEST_SET_PATH=datasets/trade-exception-test-set-v1.0.jsonl

# Prompt version under test (default v4). Keep test set frozen when changing this.
# v4 -> prompts/engineered-v4.md
# v5 -> engineered-prompt-v5.md
PROMPT_VERSION=v4
# ENGINEERED_PROMPT_PATH=prompts/engineered-v4.md
# ENGINEERED_PROMPT_PATH=engineered-prompt-v5.md
