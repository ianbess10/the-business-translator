{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebusinesstranslator.com/schemas/trade-exception-engineered-output.json",
  "title": "TradeExceptionEngineeredOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "exception_type",
    "severity",
    "known_facts",
    "missing_information",
    "evidence",
    "recommended_next_action",
    "escalation_required",
    "confidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "exception_type": {
      "type": "string",
      "enum": [
        "unmatched_trade",
        "failed_settlement",
        "partial_settlement",
        "instruction_issue",
        "counterparty_issue",
        "market_deadline",
        "data_quality",
        "other",
        "insufficient_information"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "known_facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_action": {
      "type": "string",
      "minLength": 1
    },
    "escalation_required": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
